<!DOCTYPE html>
<html
  lang="en"
  data-lotus-theme={assigns[:theme] || :lotus}
  data-lotus-themes={Enum.join(assigns[:themes] || Lotus.Web.Theme.names(), " ")}
>
  <head>
    <meta charset="utf-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="csrf-token" content={get_csrf_token()} />

    <title>{assigns[:page_title] || "Lotus"}</title>

    <style :if={Lotus.Web.Theme.css(assigns[:theme_colors])} nonce={@csp_nonces[:style]}>
      <%= Lotus.Web.Theme.css(assigns[:theme_colors]) %>
    </style>
    <link phx-track-static rel="stylesheet" nonce={@csp_nonces[:style]} href={asset_path(:css)} />
    <script phx-track-static nonce={@csp_nonces[:script]} src={asset_path(:js)} defer>
    </script>
    <script
      src="https://cdn.jsdelivr.net/npm/@tailwindplus/elements@1"
      type="module"
      nonce={@csp_nonces[:script]}
    >
    </script>
  </head>

  <body class="h-full antialiased bg-gray-200 dark:bg-black text-text-light dark:text-text-dark transition-colors duration-200 ease-out">
    {@inner_content}
  </body>
</html>
